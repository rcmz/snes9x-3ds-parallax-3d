; Uniforms
.fvec       projection[4]       ; #0 - 3
.fvec       textureScale        ; #4
.fvec       slotWindow          ; #5
                                ; x = left edge, y = right edge, in render target pixels
                                ; z = 1 while the window is in force, 0 otherwise
                                ;
                                ; A quad is held inside this window, less the shift its own
                                ; slot was given, once that shift has already moved it. The
                                ; window itself is the same for both eyes, so each slot ends
                                ; up covering the same strip of screen in both and only its
                                ; content slides within it -- which is the whole point: a
                                ; strip only one eye can see has nothing to fuse with.

; Constants
.constf c_base          (0.004032258064516, 1, -1, 0.00395) ; x: 5-bit color conversion
                                                            ; w: if we use 0.00390625, the scanline for mode 7 cannot appear!
; Outputs
.out        outpos      position
.out        outtex      texcoord0
.out        outcol      color

; Inputs
; v0: vertex            (x0, y0, z0, w = 1)
; v1: texcoord          (tx0, ty0)
; v2: color         
;
; v3: vertex            (x1, y1, z1, w = 1), if y < -1, then this is a mode 7 tile.
; v4: texcoord          (tx1, ty1)
; v5: color             same as v2

.entry gmain
.proc gmain
    mov     r7, c_base
    mov     outpos.w, r7.y              ; required for citra

    ; The two corners and their texture coordinates, taken as they arrive so
    ; the window below can pull them in before anything is projected.
    mov     r5, v0
    mov     r6, v3
    mov     r11, v1
    mov     r12, v4

    cmp     slotWindow.zzzz, lt, lt, r7.yyyy    ; window not in force?
    jmpc    cmp.x, projection_setup

    ; The slot's own shift, carried in z by both corners. A vertex that never
    ; reached a slot left it far negative, which widens the window past
    ; anything the frame can reach instead of closing it: mode 7 draws its
    ; lines with such a vertex, and its geometry is the screen already.
    min     r9.x, r11.zzzz, r12.zzzz
    add     r8.x, slotWindow.xxxx, r9.xxxx
    add     r8.y, slotWindow.yyyy, -r9.xxxx

    ; Where the texture has to follow the geometry to. A tile is at least one
    ; pixel wide, and a quad does not always carry one texel per pixel -- a
    ; mosaic block stretches one texel over the block, and the hi-res path
    ; packs seven texels into four pixels -- so the span is measured rather
    ; than assumed.
    add     r9.y, r6.xxxx, -r5.xxxx     ; width in pixels
    rcp     r9.z, r9.yyyy
    add     r9.w, r12.xxxx, -r11.xxxx   ; width in texels

    ; Both ends into the window, and the texture coordinates with them. Each
    ; end is held against both edges, not just the near one: a quad lying
    ; wholly outside would otherwise come back with its ends crossed, and a
    ; quad wound backwards still rasterises. Held against both, such a quad
    ; ends up with both ends on the same edge and covers nothing.
    max     r13.x, r5.xxxx, r8.xxxx
    min     r13.x, r13.xxxx, r8.yyyy
    min     r13.y, r6.xxxx, r8.yyyy
    max     r13.y, r13.yyyy, r8.xxxx
    add     r13.z, r13.xxxx, -r5.xxxx
    add     r13.w, r13.yyyy, -r6.xxxx
    mul     r13.zw, r9.zzzz, r13
    mad     r11.x, r13.zzzz, r9.wwww, r11.xxxx
    mad     r12.x, r13.wwww, r9.wwww, r12.xxxx
    mov     r5.x, r13.xxxx
    mov     r6.x, r13.yyyy

projection_setup:
    mov     r10.xyz, r5
    mov     r10.w, r7.y

    ; outpos = projection * in.pos
    dp4     r0.x, projection[0], r10
    dp4     r0.y, projection[1], r10
    dp4     r0.z, projection[2], r10
    dp4     r0.w, projection[3], r10

    ; outtex = in.texcoord
    mul     r1, textureScale, r11

	; outcol = RGBA8_TO_FLOAT4(in.color)
	mul 	r2, r7.xxxx, v2

    mov     r10.xyz, r6

    ; outpos = projection * in.pos
    dp4     r3.x, projection[0], r10
    dp4     r3.y, projection[1], r10
    dp4     r3.z, projection[2], r10
    dp4     r3.w, projection[3], r10

    ; outtex = in.texcoord
    mul     r4, textureScale, r12

    cmp     r3.y, lt, lt, r7.z          ; if (r3.y (after projection) < -1) then
    jmpc    cmp.x, mode7


    ; Emit the standard:
    ;   x0,y0,tx0,ty0       x1,y0,tx1,ty0
    ;                 +---+
    ;                 |  /|
    ;                 | / |
    ;                 |/  |
    ;                 +---+
    ;   x0,y1,tx0,ty1       x1,y1,tx1,ty1
    ;
    setemit 0                           ; top-left
    mov     outpos.xyz, r0.xyz
    mov     outtex.xy, r1.xy
    mov     outcol, r2
    emit 

    setemit 1                           ; top-right
    mov     outpos.xz, r3.xz
    mov     outpos.y, r0.y
    mov     outtex.x, r4.x
    mov     outtex.y, r1.y
    mov     outcol, r2
    emit 
    
    setemit 2, prim                     ; bottom-left
    mov     outpos.xz, r0.xz
    mov     outpos.y, r3.y
    mov     outtex.x, r1.x
    mov     outtex.y, r4.y
    mov     outcol, r2
    emit 

    setemit 0, prim inv                 ; bottom-right
    mov     outpos.xyz, r3.xyz
    mov     outtex.xy, r4.xy
    mov     outcol, r2
    emit 

    end

mode7:

    ; Emit the special case for mode 7.
    ;
    ;   x0,y0,z0,tx0,ty0        x1,y0,z0,tx1,ty1
    ;                    +---+
    ;                    |  /|
    ;                    | / |
    ;                    |/  |
    ;                    +---+
    ;   x0,y1,z0,tx0,ty0        x1,y1,z0,tx1,ty1
    ;
    add     r3.y, r0.y, r7.w            ; r3.y = r0.y + 1 scan line

    setemit 0                           ; top-left
    mov     outpos.xyz, r0.xyz
    mov     outtex.xy, r1.xy
    mov     outcol, r2
    emit 

    setemit 1                           ; top-right
    mov     outpos.x, r3.x
    mov     outpos.y, r0.y              ; mov outpos.yz, r0.yz won't work
    mov     outpos.z, r0.z
    mov     outtex.xy, r4.xy
    mov     outcol, r2
    emit 
    
    setemit 2, prim                     ; bottom-left
    mov     outpos.xz, r0.xz
    mov     outpos.y, r3.y
    mov     outtex.xy, r1.xy
    mov     outcol, r2
    emit 

    setemit 0, prim inv                 ; bottom-right
    mov     outpos.x, r3.x
    mov     outpos.y, r3.y
    mov     outpos.z, r0.z
    mov     outtex.xy, r4.xy
    mov     outcol, r2
    emit

    end

.end